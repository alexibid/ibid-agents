{
  "name": "@ibid/langgraph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hands out one development step at a time and verifies it before the next",
  "bin": {
    "ibid-langgraph": "dist/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.spec.json",
    "test": "vitest run",
    "start": "node dist/server.js",
    "studio": "langgraphjs dev",
    "evals": "node dist/evals/run-evals.js"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@langchain/core": "^1.3.7",
    "@langchain/langgraph": "^1.7.3",
    "@langchain/langgraph-checkpoint-sqlite": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "pg": "^8.23.1",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@langchain/langgraph-cli": "^1.7.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "vitest": "^5.1.0"
  }
}
